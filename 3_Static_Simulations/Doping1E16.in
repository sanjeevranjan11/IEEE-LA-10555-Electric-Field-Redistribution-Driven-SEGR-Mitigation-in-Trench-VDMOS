######################################################################################################################################################
# DC Breakdown Simulation
go atlas
mesh infile=VD-HK-SJ-VDMOS.str
models consrh cvt
impact selb
contact name=gate n.poly
INTERFACE QF=3e10 
method climit=1e-4 maxtraps=6
solve init
solve previous
log outfile=VD-HK-SJ-VDMOS-BV.log
solve vdrain=0.1
#
extract name="vt" (xintercept(maxslope(curve(abs(v."gate"),abs(i."drain")))) - abs(ave(v."drain"))/2.0)
#
extract name="vt" (xintercept(maxslope(curve(abs(v."gate"),abs(i."drain")))) - abs(ave(v."drain"))/2.0)
#
extract name="vt" (xintercept(maxslope(curve(abs(v."gate"),abs(i."drain")))) - abs(ave(v."drain"))/2.0)
solve vdrain=0.5 vstep=0.5 vfinal=650 name=drain
tonyplot VD-HK-SJ-VDMOS-BV.log 
save outfile=VD-HK-SJ-VDMOS-BV.str
log off
#
extract name="bvds" x.val from curve(abs(v."drain"),abs(i."drain")) where y.val = 1.0e-6/$"width"
######################################################################################################################################################
######################################################################################################################################################
extract name="nvt" (xintercept(maxslope(curve(abs(v."gate"),abs(i."drain")))) \
	- abs(ave(v."drain"))/2.0)
extract name="subvt" 1.0/slope(maxslope(curve(abs(v."gate"),log10(abs(i."drain")))))
extract name="nbeta" slope(maxslope(curve(abs(v."gate"),abs(i."drain")))) \
	* (1.0/abs(ave(v."drain")))
extract name="ntheta" ((max(abs(v."drain")) * $"nbeta")/max(abs(i."drain"))) \
	- (1.0 / (max(abs(v."gate")) - ($"nvt")))
######################################################################################################################################################
