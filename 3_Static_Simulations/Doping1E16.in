go atlas

mesh infile=Trench-HK-SJ-VDMOS.str 

set let=89
set density=$let*0.011

models consrh cvt auger
contact name=gate n.poly

singleeventupset entrypoint="6.25,0,0" exitpoint="6.25,57,0" radialgauss \
      b.density=$density pcunits radius=0.07 t0=1e-14 tc=1e-15

probe name=Strike_Field field dir=270 x=5.02 y=-0.005
probe name=Source_Field field dir=270 x=8.0 y=-0.005

method climit=1e-4

# Set Up DC Bias Condition
solve init
solve previous
solve vgate=0
solve vgate=-0.1
solve vgate=-0.4 vstep=-0.5 vfinal=-20 name=gate
solve vdrain=0.1
solve vdrain=0.5 vstep=0.5 vfinal=150 name=drain
# Start SEU Transient Simulation
log outfile=VG_89_150_1_0.log
solve tfinal=1e-14 dt=1e-16
save outfile=VG_89_150_1_1.str
solve tfinal=5e-12 dt=1e-16
save outfile=VG_89_150_1_2.str
solve tfinal=50e-12 dt=1e-15
save outfile=VG_89_150_1_3.str
solve tfinal=150e-12 dt=1e-14
save outfile=VG_89_150_1_4.str
