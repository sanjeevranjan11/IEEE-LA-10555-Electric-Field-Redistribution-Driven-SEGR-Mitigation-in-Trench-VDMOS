######################################################################################################################################################
#**************************************ATLAS_VERSION-PARALLEL_ATLAS***********************************************************************************
######################################################################################################################################################
go atlas simflags="-P 4"
go atlas simflags="-V 5.28.1.R"
mesh space.mult=1.0
######################################################################################################################################################
#**************************************Mesh-Region-Electrode-Doping***********************************************************
######################################################################################################################################################
#***********Define X MESH*****************************************************************************************************************************
x.mesh loc=0.0 spac=0.5
x.mesh loc=1 spac=0.5
x.mesh loc=1.15 spac=0.5
x.mesh loc=1.5 spac=0.5
x.mesh loc=2 spac=0.5
x.mesh loc=2.30 spac=0.5
x.mesh loc=2.31 spac=0.5
x.mesh loc=2.32 spac=0.5
x.mesh loc=2.55 spac=0.5
x.mesh loc=2.80 spac=0.5
x.mesh loc=2.81 spac=0.5
x.mesh loc=2.82 spac=0.5
x.mesh loc=2.83 spac=0.5
x.mesh loc=3 spac=0.5
x.mesh loc=4 spac=0.5
x.mesh loc=5 spac=0.5
x.mesh loc=6 spac=0.5
x.mesh loc=7 spac=0.5
x.mesh loc=7.180 spac=0.5
x.mesh loc=7.190 spac=0.5
x.mesh loc=7.44 spac=0.5
x.mesh loc=7.690 spac=0.5
x.mesh loc=8.0 spac=0.5
x.mesh loc=8.34 spac=0.5
x.mesh loc=8.4 spac=0.5
x.mesh loc=8.5 spac=0.5
x.mesh loc=8.59 spac=0.5
x.mesh loc=8.6 spac=0.5
x.mesh loc=9.0 spac=0.5
x.mesh loc=9.74 spac=0.5
x.mesh loc=10.0 spac=0.5
######################################################################################################################################################
#***********Define Y MESH*****************************************************************************************************************************
y.mesh loc=-1 spac=0.5
y.mesh loc=-0.5 spac=0.5
y.mesh loc=0.0 spac=0.5
y.mesh loc=0.4 spac=0.5
y.mesh loc=0.5 spac=0.5
y.mesh loc=0.6 spac=0.5
y.mesh loc=1.0 spac=0.5
y.mesh loc=1.4 spac=0.5
y.mesh loc=1.5 spac=0.5
y.mesh loc=1.6 spac=0.5
y.mesh loc=1.67 spac=0.5
y.mesh loc=1.68 spac=0.5
y.mesh loc=1.69 spac=0.5
y.mesh loc=1.70 spac=0.5
y.mesh loc=2.0 spac=0.5
y.mesh loc=3 spac=0.5
y.mesh loc=4 spac=0.5
y.mesh loc=5 spac=0.5
y.mesh loc=6 spac=0.5
y.mesh loc=6.5 spac=0.5
y.mesh loc=7 spac=0.5
y.mesh loc=7.5 spac=0.5
y.mesh loc=8 spac=0.5
y.mesh loc=8.5 spac=0.5
y.mesh loc=9 spac=0.5
y.mesh loc=9.5 spac=0.5
y.mesh loc=10 spac=0.5
y.mesh loc=10.5 spac=0.5
y.mesh loc=11 spac=0.5
y.mesh loc=11.5 spac=0.5
y.mesh loc=12 spac=0.5
y.mesh loc=13 spac=0.5
y.mesh loc=14 spac=0.5
y.mesh loc=15 spac=0.5
y.mesh loc=16 spac=0.5
######################################################################################################################################################
#*************************Define the Region **********************************************************************************************************
region  number=1 x.min=0 x.max=10 y.min=0 y.max=16 material=silicon
region  number=2  x.min=3 x.max=7 y.min=0 y.max=1.5 material=Poly
region  number=3 x.min=2.82 x.max=3 y.min=0 y.max=1.68 material=Si3N4
region  number=4 x.min=2.81 x.max=2.82 y.min=0 y.max=1.69 material=Sio2
region  number=5 x.min=7 x.max=7.180 y.min=0 y.max=1.68 material=Si3N4
region  number=6 x.min=7.180 x.max=7.190 y.min=0 y.max=1.69 material=Sio2
region  number=7 x.min=3 x.max=7 y.min=1.5 y.max=1.68 material=Si3N4
region  number=8 x.min=2.82 x.max=7.180 y.min=1.68 y.max=1.69 material=Sio2
region  number=9 x.min=0 x.max=1.15 y.min=-1 y.max=0 material=Air
region  number=10 x.min=2.55 x.max=7.44 y.min=-1 y.max=0 material=Air
region  number=11 x.min=8.59 x.max=10 y.min=-1 y.max=0 material=Air
region  number=12 x.min=0 x.max=10 y.min=14 y.max=15 material=silicon
######################################################################################################################################################
#***********************Define the Electrodes *******************************************************************************************************
electrode  name=gate  x.min=3 x.max=7 y.min=0 y.max=1.5 material=Poly
electrode  name=drain  x.min=0 x.max=10 y.min=15 y.max=16 material=Aluminum
electrode  name=source x.min=1.15 x.max=2.55 y.min=-1 y.max=0 material=Aluminum
electrode  name=source x.min=7.44 x.max=8.59 y.min=-1 y.max=0 material=Aluminum
###################################################################################################################################################
#**********************************************************Define the Doping Concentrations***********************************************************
######################################################################################################################################################
#***********************N+ SUBSTRATE*******************************************************************************************************************
doping  n.type conc=1e19 x.min=0 x.max=10 y.min=14 y.max=15 uniform
#********************N EPITAXAIL LAYER***************************************************************************************************************
doping  n.type conc=1.5e15 x.min=0 x.max=10 y.min=1.5 y.max=15 uniform
#doping  n.type conc=1.5e15 x.min=0 x.max=2.81 y.min=1.5 y.max=15 uniform
#doping  n.type conc=1.5e15 x.min=2.81 x.max=7.190 y.min=1.69 y.max=15 uniform
#doping  n.type conc=1.5e15 x.min=7.190 x.max=12 y.min=1.5 y.max=15 uniform
#####################################################################################################################################################
#*********************************Define the Doping Concentrations***********************************************************************************
#*************************UNIFORM*******SOURCE N+****************************************************************************************************
doping  n.type conc=3e19 x.min=2.31 x.max=2.82 y.min=0 y.max=0.5 uniform
doping  n.type conc=3e19 x.min=7.190 x.max=7.69 y.min=0 y.max=0.5 uniform
#*************************UNIFORM*******PBODY*********************************************************************************************************
doping  p.type conc=2.8e16 x.min=2.31 x.max=2.82 y.min=0.5 y.max=1.5 uniform
doping  p.type conc=2.8e16 x.min=7.190 x.max=7.69 y.min=0.5 y.max=1.5 uniform
#*************************UNIFORM*******P+ PLUG******************************************************************************************************
doping  p.type conc=2.26e19 x.min=0 x.max=2.31 y.min=0 y.max=1.5 uniform
doping  p.type conc=2.26e19 x.min=7.69 x.max=10 y.min=0 y.max=1.5 uniform
#************************UNIFORM*******P+ ISLAND******************************************************************************************************
doping  P.type conc=2e16 x.min=0 x.max=1.5 y.min=6.5 y.max=7.5 uniform
doping  P.type conc=2e16 x.min=8.5 x.max=10 y.min=6.5 y.max=7.5 uniform
doping  P.type conc=2e16 x.min=0 x.max=1.5 y.min=8.5 y.max=9.5 uniform
doping  P.type conc=2e16 x.min=8.5 x.max=10 y.min=8.5 y.max=9.5 uniform
###################################################################################################################################################
######################################################################################################################################################
struct outf=L1-Trench-HK-Single-FLI-VDMOS-Prop-6.5-7.5.str
tonyplot L1-Trench-HK-Single-FLI-VDMOS-Prop-6.5-7.5.str
######################################################################################################################################################
#****************************************Define Material-Models-contact-interface********************************************************************
#################################################################################################################################################### 
models SRH AUGER FLDMOB CONMOB FERMI ANALYTIC
IMPACT SELB
contact name=gate n.poly
method newton 
#interface qf=3e10 x.min=2.5 x.max=2.55 y.min=1.6 y.max=4
#################################################################################################################################################### 
#****************************************Define Numerical Method*************************************************************************************
######################################################################################################################################################
#method newton gummel DVMAX=1e8
#################################################################################################################################################### 
#****************************************Solution-Specification-LOG-SOLVE-LOAD-SAVE******************************************************************
######################################################################################################################################################
#****************************************RESULT-ANALYSIS-EXTRACT-TONYPLOT*****************************************************************************
######################################################################################################################################################
############# Vt Test : Returns Vt, Beta and Theta ################
######################################################################################################################################################
go atlas
mesh infile=L1-Trench-HK-Single-FLI-VDMOS-Prop-6.5-7.5.str
#set material models
models cvt srh print 
contact name=gate n.poly
#interface qf=3e10 x.left=2.5 x.right=2.55 y.top=1.6 y.bottom=4
method newton
solve init
# Bias the drain 
solve vdrain=0.1 
# Ramp the gate
log outf=L1-Trench-HK-Single-FLI-VDMOS-Vth-Prop-6.5-7.5.log 
solve vgate=0 vstep=0.25 vfinal=15 name=gate
save outf=L1-Trench-HK-Single-FLI-VDMOS-Vth-Prop-6.5-7.5.str
tonyplot=L1-Trench-HK-Single-FLI-VDMOS-Vth-Prop-6.5-7.5.str
# plot results
tonyplot L1-Trench-HK-Single-FLI-VDMOS-Vth-Prop-6.5-7.5.log 
#
extract name="vt" (xintercept(maxslope(curve(abs(v."gate"),abs(i."drain")))) - abs(ave(v."drain"))/2.0)
#####################################################################################################################################################################
# DC Breakdown Simulation
go atlas
mesh infile=L1-Trench-HK-Single-FLI-VDMOS-Prop-6.5-7.5.str
models cvt srh print
impact selb
contact name=gate n.poly
#INTERFACE QF=3e10 
method climit=1e-4 maxtraps=6
solve init
solve previous
log outfile=L1-Trench-HK-Single-FLI-VDMOS-BV-Prop-6.5-7.5.log
solve vdrain=0.1
Solve vdrain=0.5 vstep=0.05 vfinal=300 name=drain
#
extract name="bvds" x.val from curve(abs(v."drain"),abs(i."drain")) where y.val = 1.0e-6/$"width"
tonyplot L1-Trench-HK-Single-FLI-VDMOS-BV-Prop-6.5-7.5.log 
save outfile=L1-Trench-HK-Single-FLI-VDMOS-BV-Prop-6.5-7.5.str
tonyplot L1-Trench-HK-Single-FLI-VDMOS-BV-Prop-6.5-7.5.str
#
log off
######################################################################################################################################################
#OutputCharacteristics#
#Calculation of Area Specific on resistance#
######################################################################################################################################################
solve init
solve vgate=1 
log outf=OpChar_1.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

  
solve init
solve vgate=1.5 
log outf=OpChar_1.5.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=2 
log outf=OpChar_2.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=2.5 
log outf=OpChar_2.5.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25


solve init
solve vgate=3 
log outf=OpChar_3.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=3.5 
log outf=OpChar_3.5.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25


solve init
solve vgate=4 
log outf=OpChar_4.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25


solve init
solve vgate=4.5
log outf=OpChar_4.5.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=5
log outf=OpChar_5.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=5.5
log outf=OpChar_5.5.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=6
log outf=OpChar_6.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=6.5
log outf=OpChar_6.5.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

solve init
solve vgate=7
log outf=OpChar_7.log
solve name=drain vdrain=0 vfinal=15 vstep=0.25

tonyplot -overlay OpChar_1.log OpChar_1.5.log OpChar_2.log OpChar_2.5.log OpChar_3.log OpChar_3.5.log OpChar_4.log OpChar_4.5.log OpChar_5.log OpChar_5.5.log OpChar_6.log OpChar_6.5.log OpChar_7.log
log off
quit
#################################################################################################################################################################################################