x.mesh loc=6.95 spac=0.5
x.mesh loc=7.0 spac=0.5
x.mesh loc=7.18 spac=0.5
x.mesh loc=7.19 spac=0.5
x.mesh loc=7.20 spac=0.5
x.mesh loc=8.0 spac=0.5
x.mesh loc=10.0 spac=0.5
x.mesh loc=12 spac=0.5
######################################################################################################################################################
#***********Define Y MESH*****************************************************************************************************************************
y.mesh loc=-1 spac=0.5
y.mesh loc=-0.5 spac=0.5
y.mesh loc=0.0 spac=0.5
y.mesh loc=0.4 spac=0.5
y.mesh loc=0.5 spac=0.5
y.mesh loc=0.6 spac=0.5
y.mesh loc=1.0 spac=0.5
