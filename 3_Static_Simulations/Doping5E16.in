y.mesh loc=1.69 spac=0.5
y.mesh loc=1.70 spac=0.5
y.mesh loc=2.0 spac=0.5
y.mesh loc=3.0 spac=0.5
y.mesh loc=4.0 spac=0.5
y.mesh loc=5.0 spac=0.5
y.mesh loc=5.77 spac=0.5
y.mesh loc=5.78 spac=0.5
y.mesh loc=5.79 spac=0.5
y.mesh loc=6.21 spac=0.5
y.mesh loc=6.22 spac=0.5
y.mesh loc=6.23 spac=0.5
