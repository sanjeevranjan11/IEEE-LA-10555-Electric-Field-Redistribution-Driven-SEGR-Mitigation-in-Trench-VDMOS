singleeventupset entrypoint="5,-1,0" exitpoint="5,16,0" radialgauss \
      b.density=$density pcunits radius=0.07 t0=1e-14 tc=1e-15

probe name=Strike_Field field dir=270 x=6.00 y=1.685
probe name=Source_Field field dir=270 x=10.0 y=1.685

method climit=1e-4

# Set Up DC Bias Condition
solve init
solve previous
solve vgate=0
solve vgate=-0.1
solve vgate=-0.4 vstep=-0.5 vfinal=-10 name=gate
solve vdrain=0.1
solve vdrain=0.5 vstep=0.5 vfinal=110 name=drain
# Start SEU Transient Simulation
log outfile=PropVG10_45_110_1_0.log
solve tfinal=1e-14 dt=1e-16
save outfile=PropVG10_45_110_1_1.str
solve tfinal=5e-12 dt=1e-16
save outfile=PropVG10_45_110_1_2.str
solve tfinal=50e-12 dt=1e-15
save outfile=PropVG10_45_110_1_3.str
solve tfinal=150e-12 dt=1e-14
save outfile=PropVG10_45_110_1_4.str
tonyplot PropVG10_45_110_1_0.log 
tonyplot PropVG10_45_110_1_1.str PropVG10_45_110_1_2.str PropVG10_45_110_1_3.str PropVG10_45_110_1_4.str 
solve tfinal=1e-9 dt=1e-12
tonyplot PropVG10_45_110_1_0.log
tonyplot PropVG10_45_110_1_0.str
save outfile=PropVG10_45_110_1_0.str
log off
