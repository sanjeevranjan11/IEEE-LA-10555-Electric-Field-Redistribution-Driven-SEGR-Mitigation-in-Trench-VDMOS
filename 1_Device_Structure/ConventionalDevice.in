######################################################################################################################################################
#**************************************ATLAS_VERSION-PARALLEL_ATLAS***********************************************************************************
######################################################################################################################################################
go atlas simflags="-P 4"
go atlas simflags="-V 5.28.1.R"
mesh space.mult=1.0
######################################################################################################################################################
#**************************************Mesh-Region-Electrode-Doping***********************************************************
######################################################################################################################################################
#***********Define X MESH*****************************************************************************************************************************
x.mesh loc=0.0 spac=0.5
x.mesh loc=1 spac=0.5
x.mesh loc=1.15 spac=0.5
x.mesh loc=1.5 spac=0.5
x.mesh loc=2 spac=0.5
x.mesh loc=2.30 spac=0.5
x.mesh loc=2.31 spac=0.5
x.mesh loc=2.32 spac=0.5
x.mesh loc=2.55 spac=0.5
x.mesh loc=2.80 spac=0.5
x.mesh loc=2.81 spac=0.5
x.mesh loc=2.82 spac=0.5
x.mesh loc=2.83 spac=0.5
x.mesh loc=3 spac=0.5
x.mesh loc=4 spac=0.5
x.mesh loc=5 spac=0.5
x.mesh loc=6 spac=0.5
x.mesh loc=7 spac=0.5
x.mesh loc=7.180 spac=0.5
x.mesh loc=7.190 spac=0.5
x.mesh loc=7.44 spac=0.5
x.mesh loc=7.690 spac=0.5
x.mesh loc=8.0 spac=0.5
x.mesh loc=8.34 spac=0.5
x.mesh loc=8.4 spac=0.5
x.mesh loc=8.5 spac=0.5
x.mesh loc=8.59 spac=0.5
x.mesh loc=8.6 spac=0.5
x.mesh loc=9.0 spac=0.5
x.mesh loc=9.74 spac=0.5
x.mesh loc=10.0 spac=0.5
######################################################################################################################################################
#***********Define Y MESH*****************************************************************************************************************************
y.mesh loc=-1 spac=0.5
y.mesh loc=-0.5 spac=0.5
y.mesh loc=0.0 spac=0.5
y.mesh loc=0.4 spac=0.5
y.mesh loc=0.5 spac=0.5
y.mesh loc=0.6 spac=0.5
y.mesh loc=1.0 spac=0.5
y.mesh loc=1.4 spac=0.5
y.mesh loc=1.5 spac=0.5
y.mesh loc=1.6 spac=0.5
y.mesh loc=1.67 spac=0.5
y.mesh loc=1.68 spac=0.5
y.mesh loc=1.69 spac=0.5
y.mesh loc=1.70 spac=0.5
y.mesh loc=2.0 spac=0.5
y.mesh loc=3 spac=0.5
y.mesh loc=4 spac=0.5
y.mesh loc=5 spac=0.5
y.mesh loc=6 spac=0.5
y.mesh loc=7 spac=0.5
y.mesh loc=8 spac=0.5
y.mesh loc=9 spac=0.5
y.mesh loc=10 spac=0.5
y.mesh loc=11 spac=0.5
y.mesh loc=12 spac=0.5
y.mesh loc=13 spac=0.5
y.mesh loc=14 spac=0.5
y.mesh loc=15 spac=0.5
y.mesh loc=16 spac=0.5
######################################################################################################################################################
#*************************Define the Region **********************************************************************************************************
region  number=1 x.min=0 x.max=10 y.min=0 y.max=16 material=silicon
region  number=2  x.min=2.82 x.max=7.180 y.min=0 y.max=1.68 material=Poly
region  number=3 x.min=2.81 x.max=2.82 y.min=0 y.max=1.69 material=Sio2
region  number=4 x.min=7.180 x.max=7.190 y.min=0 y.max=1.69 material=Sio2
region  number=5 x.min=2.82 x.max=7.180 y.min=1.68 y.max=1.69 material=Sio2
region  number=6 x.min=0 x.max=1.15 y.min=-1 y.max=0 material=Air
region  number=7 x.min=2.55 x.max=7.44 y.min=-1 y.max=0 material=Air
region  number=8 x.min=8.59 x.max=10 y.min=-1 y.max=0 material=Air
region  number=9 x.min=0 x.max=10 y.min=14 y.max=15 material=silicon
######################################################################################################################################################
#***********************Define the Electrodes *******************************************************************************************************
electrode  name=gate  x.min=2.82 x.max=7.180 y.min=0 y.max=1.68 material=Poly
electrode  name=drain  x.min=0 x.max=10 y.min=15 y.max=16 material=Aluminum
electrode  name=source x.min=1.15 x.max=2.55 y.min=-1 y.max=0 material=Aluminum
electrode  name=source x.min=7.44 x.max=8.59 y.min=-1 y.max=0 material=Aluminum
###################################################################################################################################################
#**********************************************************Define the Doping Concentrations***********************************************************
######################################################################################################################################################
#***********************N+ SUBSTRATE*******************************************************************************************************************
doping  n.type conc=1e19 x.min=0 x.max=10 y.min=14 y.max=15 uniform
#********************N EPITAXAIL LAYER***************************************************************************************************************
#doping  n.type conc=1.5e15 x.min=0 x.max=10 y.min=1.5 y.max=15 uniform
doping  n.type conc=1.5e15 x.min=0 x.max=2.7 y.min=1.5 y.max=15 uniform
doping  n.type conc=1.5e15 x.min=2.7 x.max=7.2 y.min=1.69 y.max=15 uniform
doping  n.type conc=1.5e15 x.min=7.2 x.max=12 y.min=1.5 y.max=15 uniform
#####################################################################################################################################################
#*********************************Define the Doping Concentrations***********************************************************************************
#*************************UNIFORM*******SOURCE N+****************************************************************************************************
doping  n.type conc=3e19 x.min=2.31 x.max=2.82 y.min=0 y.max=0.5 uniform
doping  n.type conc=3e19 x.min=7.190 x.max=7.69 y.min=0 y.max=0.5 uniform
#*************************UNIFORM*******PBODY*********************************************************************************************************
doping  p.type conc=2.8e16 x.min=2.31 x.max=2.82 y.min=0.5 y.max=1.5 uniform
doping  p.type conc=2.8e16 x.min=7.190 x.max=7.69 y.min=0.5 y.max=1.5 uniform
#*************************UNIFORM*******P+ PLUG******************************************************************************************************
doping  p.type conc=2.26e19 x.min=0 x.max=2.31 y.min=0 y.max=1.5 uniform
doping  p.type conc=2.26e19 x.min=7.69 x.max=10 y.min=0 y.max=1.5 uniform
###################################################################################################################################################
######################################################################################################################################################
struct outf=Trench-HK-Single-FLI-VDMOS-Conv.str
tonyplot Trench-HK-Single-FLI-VDMOS-Conv.str
quit
#######################################################################################################